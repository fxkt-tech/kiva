    "line.game_end_all_wolves_dead.0": {
      "file": "line.game_end_all_wolves_dead.0-6e738b0ba827.mp3",
      "text": "最后一匹狼人已经倒下。好人阵营获胜，长夜结束。",
      "durationMs": 5017
    },
    "line.game_end_all_gods_dead.0": {
      "file": "line.game_end_all_gods_dead.0-c3221b054810.mp3",
      "text": "所有神职均已出局。狼人阵营获胜，黑夜吞没了村庄。",
      "durationMs": 5281
    },
    "line.game_end_all_villagers_dead.0": {
      "file": "line.game_end_all_villagers_dead.0-f321f293cb44.mp3",
      "text": "所有平民均已出局。狼人阵营获胜，村庄再无天明。",
      "durationMs": 5137
    },
    "line.game_end_all_good_dead.0": {
      "file": "line.game_end_all_good_dead.0-194543f3a454.mp3",
      "text": "最后一位好人倒下。狼人阵营获胜，猎杀结束。",
      "durationMs": 4609
    },
    "line.fallback_announcement.0": {
      "file": "line.fallback_announcement.0-05c218769f81.mp3",
      "text": "新的线索已经出现。真相，往往藏在细节里。",
      "durationMs": 4513
    },
    "line.fallback_speech.0": {
      "file": "line.fallback_speech.0-d155b85ffe9a.mp3",
      "text": "该玩家选择沉默。沉默，有时也是一种答案。",
      "durationMs": 4249
    },
    "line.fallback_vote.0": {
      "file": "line.fallback_vote.0-9fbeaef8e964.mp3",
      "text": "票型已经记录。每一票，都可能暴露立场。",
      "durationMs": 4201
    },
    "line.fallback_resolution.0": {
      "file": "line.fallback_resolution.0-e3a4767036cf.mp3",
      "text": "本轮结算完毕。场上的局势，已经悄然改变。",
      "durationMs": 4393
    },
