          "target"
        ]
      },
      "action.seer_result.good": {
        "template": "查验结果：{target}属于好人阵营。请记住这个答案。",
        "variables": [
          "target"
        ]
      },
      "action.witch_death_info.killed": {
        "template": "女巫请睁眼。今晚倒下的是{target}，你要使用解药吗？",
        "variables": [
          "target"
        ]
      },
      "action.witch_death_info.safe": {
        "template": "女巫请睁眼。今晚无人中刀。",
        "variables": []
      },
