      "phase.speech": { "template": "现在进入发言环节。听清每一句话，也别轻信任何一个人。", "variables": [], "voice": { "file": "phase_speech_start.mp3", "status": "pending" } },
      "phase.vote": { "template": "发言结束。请投出你认为最像狼人的那一票。", "variables": [], "voice": { "file": "phase_vote_start.mp3", "status": "pending" } },
      "phase.pk": { "template": "票型持平。平票玩家进入 PK 发言，请为自己争取最后的信任。", "variables": [], "voice": { "file": "phase_pk_start.mp3", "status": "pending" } },
      "phase.last_words": { "template": "请留下你的遗言。你说的每一句话，都可能改变场上的判断。", "variables": [], "voice": { "file": "phase_last_words_start.mp3", "status": "pending" } },
