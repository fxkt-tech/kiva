    "lines": {
      "phase.setup": {
        "template": "所有玩家请确认身份。好戏，即将开场。",
        "variables": []
      },
      "phase.night": {
        "template": "天黑请闭眼。所有玩家保持安静，夜间行动开始。",
        "variables": []
      },
      "phase.day": {
        "template": "天亮了，所有玩家请睁眼。昨夜的结果，即将揭晓。",
        "variables": []
      },
      "phase.speech": {
        "template": "现在进入发言环节。听清每一句话，也别轻信任何一个人。",
        "variables": []
      },
      "phase.vote": {
        "template": "发言结束。请投出你认为最像狼人的那一票。",
        "variables": []
      },
      "phase.pk": {
        "template": "票型持平。平票玩家进入 PK 发言，请为自己争取最后的信任。",
        "variables": []
      },
      "phase.last_words": {
        "template": "请留下你的遗言。你说的每一句话，都可能改变场上的判断。",
        "variables": []
      },
      "phase.ended": {
        "template": "尘埃落定。本局游戏结束，所有身份即将揭晓。",
        "variables": []
      },
      "action.role_assigned": {
        "template": "{player}，请确认你的身份牌：{role}。从现在开始，隐藏好你的秘密。",
        "variables": [
          "player",
          "role"
        ]
      },
      "action.wolf_kill": {
        "template": "狼人请睁眼。今晚，你们选择袭击{target}。",
        "variables": [
          "target"
        ]
      },
      "action.seer_check": {
        "template": "预言家请睁眼。今晚，你选择查验{target}。",
        "variables": [
          "target"
        ]
      },
      "action.seer_result.wolves": {
        "template": "查验结果：{target}属于狼人阵营。请记住这个答案。",
