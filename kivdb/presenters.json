        "template": "女巫使用了解药，{target}从死亡边缘被救回。",
        "variables": [
          "target"
        ]
      },
      "action.witch_antidote.skipped": {
        "template": "女巫选择保留解药。",
        "variables": []
      },
      "action.witch_poison.used": {
        "template": "女巫使用了毒药，{target}今夜将无法醒来。",
        "variables": [
          "target"
        ]
      },
      "action.witch_poison.skipped": {
        "template": "女巫选择保留毒药。",
